# Relay environment configuration
# -------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values. The .env
# file is git-ignored — never commit real keys.
#
# A single OpenRouter key is reused by every Relay subsystem that
# talks to a model:
#   - intent extraction (fast model)   → src/llm/extractor.py
#   - chat fallback                     → src/chat/chat_service.py
#   - email/note/reminder polish (slow) → src/content/engine.py

# Required for any LLM-backed behavior. Without it, Relay still runs
# in offline / fallback mode (deterministic best-guess routing).
OPENROUTER_API_KEY=

# Optional model overrides. Leave blank to use the defaults.
# Fast model is used for routing/extraction — must feel instant.
# OPENROUTER_FAST_MODEL=qwen/qwen-2.5-7b-instruct:free
# Slow model is used only for content polish (email body / subject,
# note formatting, reminder rewording, summaries).
# OPENROUTER_SLOW_MODEL=anthropic/claude-3.5-sonnet
# OpenRouter base URL — only override if you're proxying.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
